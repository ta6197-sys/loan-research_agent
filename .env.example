# LangSmith 추적 설정 — 실제 값은 .env에 넣는다 (.env는 git에 커밋하지 않음)
# 이 저장소에서는 ../../../../_통합개념_실습/LANGSMITH/base-langsmith/.env를
# 복사해 써도 된다 (run.sh가 .env가 없으면 자동 복사).
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=capstone-all-total
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# LLM_BACKEND=openai 모드(run_openai.sh)에서만 필요 — 실제 OpenAI 계정에 과금되는
# 원격 API 키다. 절대 커밋하지 말고, 본인 계정의 유효한 키를 .env에만 넣을 것.
OPENAI_API_KEY=sk-...
# 기본값: fast=gpt-4o-mini, quality=gpt-4o (원하면 아래로 재정의)
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_QUALITY_MODEL=gpt-4o
# OpenDART: 실제 인증키는 로컬 .env 파일에 입력합니다.
OPENDART_API_KEY=

# 기본은 조사 저장 기반(0~1단계). 기존 실습 채팅은 legacy를 명시한다.
APP_MODE=research
# 키가 있어도 아래 설정 없이는 외부 모델/추적을 사용하지 않는다.
APP_ALLOW_EXTERNAL_MODEL=false
APP_ALLOW_EXTERNAL_TRACE=false

# 금융 조사 기본값은 local이다. OpenAI 금융 초안은 .env.openai.local에 키를 두고
# sh/run_research_openai.sh로만 명시적으로 기동한다.
FINANCE_MODEL_BACKEND=local
FINANCE_ALLOW_EXTERNAL_MODEL=false
# OPENAI_FINANCE_MODEL=gpt-5-mini
# 공개 공시 원문의 allow_external_model=false를 사용자 책임으로 한 번만 예외 허용할 때만 true.
# FINANCE_ALLOW_ARCHIVED_PUBLIC_EXTERNAL_MODEL=false

# DART 전송/ZIP 안전 한도(바이트·파일 수). 초과 시 잘라 읽지 않고 실패를 표시한다.
# DART_MAX_RESPONSE_BYTES=104857600
# DART_MAX_EXPANDED_BYTES=268435456
# DART_MAX_ARCHIVE_MEMBERS=100
